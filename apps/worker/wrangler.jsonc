{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeromalaria",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeromalaria",
      "database_id": "replace-after-running-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    "PINDO_API_BASE_URL": "https://api.pindo.io",
    "OVERDUE_HOURS": "24"
  }
}
