# ZeroMalaria environment example — copy to /.env (never commit secrets)
ZM_DEMO_MODE=true
ZM_DEMO_PASSWORD=demo1234
ZM_JWT_SECRET=zeromalaria-demo-secret-change-in-production
# Frontend (apps/web/.env.development or build-time)
VITE_DEMO_MODE=true
ZM_GEMINI_API_KEY=
ZM_GROQ_API_KEY=
ZM_GOOGLE_CLOUD_PROJECT=
ZM_AI_PROVIDER_ORDER=gemini,groq,local
ZM_AI_TIMEOUT_SECONDS=4
