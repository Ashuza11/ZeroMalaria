# ZeroMalaria environment example — copy to /.env (never commit secrets)
ZM_DEMO_MODE=true
ZM_DEMO_PASSWORD=demo1234
ZM_JWT_SECRET=zeromalaria-demo-secret-change-in-production
# prompt = dismissible password modal (default); enforce = must change before API use
# Non-demo deployments should consider ZM_PASSWORD_CHANGE_POLICY=enforce
ZM_PASSWORD_CHANGE_POLICY=prompt
# Frontend: synthetic-data banner only (no role buttons on login)
VITE_DEMO_MODE=true
ZM_GEMINI_API_KEY=
ZM_GROQ_API_KEY=
ZM_GOOGLE_CLOUD_PROJECT=
ZM_AI_PROVIDER_ORDER=gemini,groq,local
ZM_AI_TIMEOUT_SECONDS=4
